{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Haus Culture",
  "version": "20.35.0",
  "identifier": "tr.hausculture.ozluk",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Av. İsmail Sarğın",
    "copyright": "Av. İsmail Sarğın",
    "shortDescription": "Haus Culture Özlük Otomasyonu",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Turkish"],
        "displayLanguageSelector": false
      }
    }
  }
}
